rules_version = '2';

// Rules for FirebaseStorageImageService (switched off on the Spark plan).
service firebase.storage {
  match /b/{bucket}/o {
    // Signed in with a verified ALU email.
    function isVerifiedAluUser() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower()
             .matches('.*@(alustudent|alueducation)[.]com$');
    }

    // Photos are saved as incidents/{incidentId}.jpg.
    match /incidents/{fileName} {
      allow read: if isVerifiedAluUser();

      // Only the incident's reporter may upload, once, as a JPEG under 700 KB.
      allow create: if isVerifiedAluUser()
        && fileName.matches('[^.]+\\.jpg')
        && request.resource.size < 700 * 1024
        && request.resource.contentType == 'image/jpeg'
        && request.resource.metadata.ownerId == request.auth.uid
        && firestore.get(/databases/(default)/documents/incidents/$(fileName.split('\\.')[0])).data.reporterId == request.auth.uid;

      // Deleted with its report, while that report is still "submitted".
      allow delete: if isVerifiedAluUser()
        && resource.metadata.ownerId == request.auth.uid
        && firestore.get(/databases/(default)/documents/incidents/$(fileName.split('\\.')[0])).data.status == 'submitted';

      // Photos can't be replaced.
      allow update: if false;
    }
  }
}
